# Forma AI Environment Variables

# Google Gemini API Key (Recommended - free tier available at Google AI Studio)
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback for GPT-4o models)
# Get yours here: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
